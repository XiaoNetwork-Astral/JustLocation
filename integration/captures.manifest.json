{
  "_comment": "Field contract of the probe app's captures. Integration scripts read these files on the host while the probe writes them on the device, so a renamed field would otherwise only be discovered during a device run. Each entry names the probe source that writes it; integration/captures-manifest.test.mjs keeps the two in step.",
  "captures": {
    "location-continuity.jsonl": {
      "probe": "app/probe/src/main/java/me/idk/justlocation/probe/LocationChecks.kt",
      "events": ["collection_start", "callback", "last_known"],
      "keys": [
        "event",
        "provider",
        "received_ms",
        "present",
        "fix_provider",
        "fix_time_ms",
        "fix_elapsed_ms",
        "fix_age_ms",
        "latitude",
        "longitude",
        "accuracy",
        "speed",
        "bearing",
        "mock",
        "extras_satellites",
        "error_class"
      ]
    },
    "amap-continuity.jsonl": {
      "probe": "app/probe/src/main/java/me/idk/justlocation/probe/AmapCapture.kt",
      "events": ["start", "fix", "error"],
      "keys": [
        "event",
        "mode",
        "cache",
        "error_code",
        "error_info",
        "location_type",
        "provider",
        "latitude",
        "longitude",
        "accuracy",
        "speed",
        "fix_time_ms",
        "fix_elapsed_ms",
        "coord_type",
        "satellites",
        "gps_accuracy_status",
        "mock",
        "received_ms",
        "sdk_version",
        "app_package",
        "app_version",
        "api_level",
        "error_class"
      ]
    },
    "environment-snapshot.json": {
      "probe": "app/probe/src/main/java/me/idk/justlocation/probe/EnvironmentCollector.kt",
      "events": [],
      "keys": [
        "version",
        "captured_ms",
        "simulated",
        "coordinate_system",
        "location",
        "cells",
        "wifi",
        "capture",
        "latitude",
        "longitude",
        "altitude",
        "accuracy",
        "speed",
        "bearing",
        "provider",
        "from_last_known",
        "fix_time_ms",
        "fix_elapsed_ms",
        "received_elapsed_ms",
        "mock",
        "extras_satellites",
        "package",
        "location_permission",
        "wifi_permission",
        "phone_permission",
        "location_enabled",
        "sdk",
        "mock_active",
        "radio",
        "area",
        "id",
        "mcc",
        "mnc",
        "registered",
        "dbm",
        "connection_status",
        "SSID",
        "BSSID",
        "rssi",
        "frequency",
        "scan_ms"
      ]
    }
  }
}
